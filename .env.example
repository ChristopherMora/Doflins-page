# App
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_WOO_PRODUCT_URL=https://dofer.mx
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-01
# OAuth2 para Shopify Admin API (referidos + pedidos)
SHOPIFY_API_CLIENT_ID=
SHOPIFY_API_CLIENT_SECRET=
SHOPIFY_COLLECTION_ANIMALS_HANDLE=animals
SHOPIFY_COLLECTION_MULTIVERSE_HANDLE=multiverse
SHOPIFY_CATALOG_CACHE_TTL_MS=45000
NEXT_PUBLIC_SHOPIFY_LIVE_REFRESH_MS=15000
SHOPIFY_FREE_GIFT_VARIANT_ID=
SHOPIFY_FREE_GIFT_QUANTITY=1
SHOPIFY_FREE_GIFT_MIN_PAID_ITEMS=1
SHOPIFY_FREE_GIFT_MIN_PAID_SUBTOTAL=450
NEXT_PUBLIC_FREE_GIFT_PROMO_LABEL=
NEXT_PUBLIC_FREE_GIFT_MIN_SUBTOTAL=450
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=

# Database (MySQL)
DATABASE_URL=mysql://doflins:doflins@mysql:3306/doflins

# Optional startup behavior inside container
WAIT_FOR_DB=true
DB_WAIT_TIMEOUT_SECONDS=120
DB_WAIT_INTERVAL_SECONDS=3
RUN_DB_MIGRATIONS=true

# Admin auth (Supabase + optional fallback token)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAILS=
ADMIN_FORM_TOKEN=

# Optional analytics/pixels
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
